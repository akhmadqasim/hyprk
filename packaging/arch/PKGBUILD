# hyprk for Arch / Manjaro / EndeavourOS. Built and packaged in an archlinux container (Hyprland 0.57.2) on 2026-11-10,
# never installed or run as a session. Source = the local checkout (HYPRK_SRC, default two dirs above this file), so only
# COMMITTED files are packaged.
#
#   cd packaging/arch && makepkg -si
#
# !! The built package CONTAINS APPLE FONTS, ICONS, CURSORS, SOUNDS AND WALLPAPERS. It is for your own machines only.
# !! NEVER upload it or this source tree with the assets anywhere: not the AUR, not a repo, not a release, not a cache.
# What goes in: everything tracked except reference/, packaging/, state/, sounds/originals (duplicates of sounds/wav)
# and the wallpaper collection. Only the wallpapers in _wallpapers are included, downscaled (see package()).
# The rest of the wallpapers: copy them to /usr/share/hyprk/themes/wallpapers/png/ by hand (packaging/README.md).
#
# /usr/share/hyprk is read-only: config/hypr/state-dir.sh (sourced by start.sh) puts the state in
# ${XDG_STATE_HOME:-~/.local/state}/hyprk then, so the wrapper below does not set HYPRK_STATE.
# The liquidglass plugin is ABI-locked to the exact Hyprland build: package() pins the installed hyprland version,
# so pacman refuses a mismatched pair. Rebuild this package on every hyprland update.
pkgname=hyprk-git
pkgver=r0
pkgrel=1
pkgdesc='macOS 27-look desktop on Hyprland: Quickshell shell, Liquid Glass plugin, Finder, System Settings (contains Apple assets, private use only)'
arch=('x86_64' 'aarch64')
url='https://example.invalid/hyprk'   # private repo, no public URL; do not publish this package
license=('custom')                    # not chosen yet (namcap wants an SPDX id or a license file)
depends=('hyprland>=0.57' 'quickshell>=0.3.2' 'hyprlock>=0.9' 'hypridle'
         'qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg'
         'imagemagick' 'jq' 'pipewire' 'wireplumber' 'brightnessctl' 'networkmanager' 'bluez-utils' 'upower'
         'grim' 'slurp' 'swaybg' 'python' 'python-pillow' 'poppler' 'glib2' 'xdg-user-dirs' 'fontconfig'
         'inter-font' 'ttf-dejavu' 'adwaita-icon-theme' 'xorg-xwayland')
makedepends=('git' 'cmake' 'ninja' 'pkgconf' 'gcc' 'pixman' 'libdrm')
optdepends=('foot: default terminal' 'ghostty: terminal hyprk is tuned for' 'qt6ct: macOS look for Qt apps'
            'kvantum: rounded Qt menus' 'nodejs: run the QML logic tests')
options=('!debug')   # the two binaries live under /usr/share/hyprk (hyprk looks for them there), no separate debug package
source=("hyprk::git+file://${HYPRK_SRC:-$(cd ../.. && pwd)}")
sha256sums=('SKIP')

# Left out (keep in sync with NOSHIP / SHIP_WALLPAPERS in packaging/install.sh, the spec and the flake):
_noship='^(reference|packaging|state|themes/wallpapers|sounds/originals)/'
_wallpapers=(TahoeLight.png TahoeDark.png DefaultAerial.png)   # themes/wallpapers/png, the defaults the code uses
_wpmax=3840                                                    # px, the originals are 6016 px and 46 MB each

pkgver() {
    cd hyprk
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd hyprk
    cmake -S finder -B build-finder -G Ninja -DCMAKE_BUILD_TYPE=Release
    cmake --build build-finder
    cmake -S plugin -B build-plugin -G Ninja -DCMAKE_BUILD_TYPE=Release
    cmake --build build-plugin --target liquidglass
}

package() {
    cd hyprk
    local root="$pkgdir/usr/share/hyprk"
    local hl; hl=$(pacman -Q hyprland 2>/dev/null | cut -d' ' -f2)
    [ -z "$hl" ] || depends+=("hyprland=$hl")   # plugin ABI: exact Hyprland build
    install -d "$root"
    git ls-files -z | grep -zvE "$_noship" | tar --null -T - -cf - | tar -C "$root" -xf -
    install -Dm755 build-finder/hyprk-finder "$root/finder/build/hyprk-finder"
    install -Dm755 build-plugin/libliquidglass.so "$root/plugin/build/libliquidglass.so"
    # the default wallpapers, downscaled, plus gradient fallbacks (same as install.sh)
    install -d "$root/themes/wallpapers/png"
    local w
    for w in "${_wallpapers[@]}"; do
        magick "themes/wallpapers/png/$w" -resize "${_wpmax}x${_wpmax}>" -define png:compression-level=9 \
            "$root/themes/wallpapers/png/$w"
    done
    magick -size 3840x2160 'gradient:#2f7fd8-#7cc4f0' \( -size 3840x2160 'radial-gradient:#9a7be0-none' \) \
        -compose over -composite "$root/themes/wallpapers/png/hyprk-gradient-light.png"
    magick -size 3840x2160 'gradient:#0b1a3a-#1d4f8f' \( -size 3840x2160 'radial-gradient:#3a1f5c-none' \) \
        -compose over -composite "$root/themes/wallpapers/png/hyprk-gradient-dark.png"
    # hyprlock has no relative paths
    sed -i 's|/mnt/code/hyprk|/usr/share/hyprk|g' "$root/lockscreen/hyprlock.conf"
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/hyprk-session" <<'SH'
#!/bin/sh
export HYPRK_ROOT=/usr/share/hyprk HYPRK_DEV=/usr/share/hyprk/dev
exec /usr/share/hyprk/dist/hyprk-session "$@"
SH
    install -d "$root/dev"; echo ': # distro Hyprland' > "$root/dev/env.sh"
    install -Dm644 /dev/stdin "$pkgdir/usr/share/wayland-sessions/hyprk.desktop" <<'DESK'
[Desktop Entry]
Name=hyprk
Comment=Hyprland that looks like macOS
Exec=/usr/bin/hyprk-session
TryExec=/usr/bin/hyprk-session
Type=Application
DesktopNames=Hyprland
DESK
}
