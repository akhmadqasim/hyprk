[Icon Theme]
Name=hyprk-apple
Comment=Local macOS app icons (not redistributable), generated by build-apple-theme.sh
Inherits=WhiteSur,Yaru-blue-dark,Adwaita,hicolor
Directories=512x512/apps,128x128/apps

[512x512/apps]
Size=512
MinSize=129
MaxSize=1024
Context=Applications
Type=Scalable

[128x128/apps]
Size=128
MinSize=16
MaxSize=128
Context=Applications
Type=Scalable
