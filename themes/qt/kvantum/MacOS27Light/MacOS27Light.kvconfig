[%General]
author=hyprk
comment=macOS 27 look (original work, generated by build_kvantum.py)
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=6
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
splitter_width=7
scroll_width=10
scroll_min_extent=40
scroll_arrows=false
transient_scrollbar=true
transient_groove=true
slider_width=4
slider_handle_width=24
slider_handle_length=18
tickless_slider_handle_size=18
center_toolbar_handle=true
toolbar_interior_spacing=4
check_size=16
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=false
fill_rubberband=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
animate_states=true
combo_as_lineedit=false
combo_menu=true
combo_focus_rect=false
groupbox_top_label=true
inline_spin_indicators=true
joined_inactive_tabs=false
layout_spacing=6
scrollbar_in_view=false
submenu_overlap=0
tooltip_delay=-1
opaque=kaffeine;kmplayer;subtitlecomposer;kdenlive;vlc;smplayer;smplayer2;avidemux;avidemux3_qt5;avidemux3_jobs_qt5;dragon;kwrite;kate;gwenview;vokoscreenNG;
respect_DE=true

[GeneralColors]
window.color=#FFFFFF
base.color=#FFFFFF
alt.base.color=#F7F7F7
button.color=#FFFFFF
light.color=#ffffff
mid.light.color=#ffffff
dark.color=#bfbfbf
mid.color=#e0e0e0
highlight.color=#007AFF
inactive.highlight.color=#007AFF
text.color=#262626
window.text.color=#262626
button.text.color=#262626
disabled.text.color=#A6A6A6
tooltip.base.color=#FAFAFA
tooltip.text.color=#262626
highlight.text.color=#ffffff
link.color=#0064D9
link.visited.color=#7A4EBD
progress.indicator.text.color=#ffffff

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
blur_translucent=false
transparent_menutitle=false
respect_darkness=true
disabled_icon_opacity=60
iconless_menu=false
iconless_pushbutton=true
normal_default_pushbutton=false
single_top_toolbar=true
tint_on_mouseover=0
no_selection_tint=true
transparent_arrow_button=true
force_size_grip=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=11
frame.bottom=11
frame.left=11
frame.right=11
interior=true
interior.element=button
indicator.size=10
indicator.element=arrow
text.normal.color=#262626
text.focus.color=#262626
text.press.color=#262626
text.toggle.color=#ffffff
text.shadow=0
text.margin=1
text.iconspacing=4
text.margin.top=1
text.margin.bottom=1
text.margin.left=8
text.margin.right=8
frame.expansion=0
min_height=24
min_width=+0.2font

[PanelButtonTool]
inherits=PanelButtonCommand
frame.top=11
frame.bottom=11
frame.left=11
frame.right=11
text.margin.left=4
text.margin.right=4

[ToolbarButton]
inherits=PanelButtonCommand
interior.element=tab
frame.element=tab
text.toggle.color=#262626
text.margin.left=4
text.margin.right=4

[ToolbarComboBox]
inherits=PanelButtonCommand
indicator.element=none

[ToolbarLineEdit]
inherits=LineEdit

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
