/* MacOS27 Qt stylesheet (original work). GENERATED from src/macos.qss.in by build.py, placeholders are filled per variant.
 * Used through qt6ct (Fusion style + custom palette). the assets path is filled in by install.sh. */
* { font-family: "SF Pro Text", "SF Pro", "System Font", ".SF NS", "Inter", "Cantarell", sans-serif; }
QWidget { color: #DCDCDC; selection-background-color: #1B4C80; selection-color: #DCDCDC; }
QMainWindow, QDialog, QWidget#centralwidget { background-color: #1E1E1E; }
QToolTip { background-color: #2E2E2E; color: #DCDCDC; border: 1px solid #4A4A4A; border-radius: 8px; padding: 4px 8px; }

/* buttons: capsule */
QPushButton, QToolButton {
  background-color: #3A3A3A; color: #DCDCDC; border: 1px solid #4A4A4A; border-radius: 12px;
  min-height: 22px; padding: 1px 14px;
}
QPushButton:hover, QToolButton:hover { background-color: #464646; }
QPushButton:pressed, QPushButton:checked, QToolButton:pressed, QToolButton:checked { background-color: #555555; }
QPushButton:disabled, QToolButton:disabled { color: #6E6E6E; background-color: #3A3A3A; border-color: #4A4A4A; }
QPushButton:default, QPushButton[default="true"] { background-color: #007AFF; color: #ffffff; border: 1px solid #0070E0; }
QPushButton:default:hover { background-color: #2E96FF; }
QPushButton:default:pressed { background-color: #0069D1; }
QPushButton:focus { outline: none; border: 1px solid #007AFF; }
QToolButton { padding: 1px 8px; border-color: transparent; background-color: transparent; }
QToolButton:hover { background-color: #383838; }
QToolButton::menu-indicator { image: none; }
QToolBar { background-color: #1E1E1E; border: none; spacing: 6px; padding: 4px 8px; }
QToolBar::separator { background-color: #3A3A3A; width: 1px; margin: 4px 4px; }

/* text fields */
QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox {
  background-color: #1E1E1E; color: #DCDCDC; border: 1px solid #4A4A4A; border-radius: 8px; padding: 2px 8px; min-height: 20px;
  selection-background-color: #1B4C80; selection-color: #DCDCDC;
}
QTextEdit, QPlainTextEdit { border-radius: 8px; padding: 6px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus, QComboBox:focus { border: 2px solid #007AFF; padding: 1px 7px; }
QLineEdit:disabled, QAbstractSpinBox:disabled, QTextEdit:disabled { color: #6E6E6E; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { width: 18px; border: none; background: transparent; subcontrol-origin: border; }
QAbstractSpinBox::up-arrow { image: url(@ASSETS@/chevron-up-dark.svg); width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow { image: url(@ASSETS@/chevron-down-dark.svg); width: 10px; height: 10px; }

/* combo box */
QComboBox { background-color: #3A3A3A; color: #DCDCDC; border: 1px solid #4A4A4A; border-radius: 12px; min-height: 22px; padding: 1px 12px; }
QComboBox:hover { background-color: #464646; }
QComboBox::drop-down { border: none; width: 20px; subcontrol-origin: padding; subcontrol-position: center right; }
QComboBox::down-arrow { image: url(@ASSETS@/chevron-down-dark.svg); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #2E2E2E; border: 1px solid #4A4A4A; border-radius: 8px; padding: 4px; outline: none; selection-background-color: #007AFF; selection-color: #ffffff; }

/* check / radio */
QCheckBox, QRadioButton { spacing: 8px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; background-color: #3A3A3A; border: 1px solid #6A6A6A; }
QCheckBox::indicator { border-radius: 5px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked, QCheckBox::indicator:indeterminate { background-color: #007AFF; border: 1px solid #0070E0; }
QCheckBox::indicator:checked { image: url(@ASSETS@/check.svg); }
QCheckBox::indicator:indeterminate { image: url(@ASSETS@/dash.svg); }
QRadioButton::indicator:checked { image: url(@ASSETS@/dot.svg); }
QCheckBox:disabled, QRadioButton:disabled { color: #6E6E6E; }

/* slider, progress */
QSlider::groove:horizontal { height: 4px; background-color: #404040; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #007AFF; border-radius: 2px; }
QSlider::handle:horizontal { background-color: #ffffff; border: 1px solid #2A2A2A; width: 22px; height: 16px; margin: -7px 0; border-radius: 9px; }
QSlider::groove:vertical { width: 4px; background-color: #404040; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #007AFF; border-radius: 2px; }
QSlider::handle:vertical { background-color: #ffffff; border: 1px solid #2A2A2A; height: 22px; width: 16px; margin: 0 -7px; border-radius: 9px; }
QProgressBar { background-color: #404040; border: none; border-radius: 3px; max-height: 6px; text-align: center; color: transparent; }
QProgressBar::chunk { background-color: #007AFF; border-radius: 3px; }

/* menus */
QMenuBar { background-color: #1E1E1E; padding: 2px 6px; }
QMenuBar::item { padding: 3px 10px; border-radius: 6px; background: transparent; }
QMenuBar::item:selected, QMenuBar::item:pressed { background-color: #383838; }
QMenu { background-color: #2E2E2E; color: #DCDCDC; border: 1px solid #4A4A4A; border-radius: 10px; padding: 6px; }
QMenu::item { padding: 4px 24px 4px 12px; border-radius: 6px; min-height: 18px; }
QMenu::item:selected { background-color: #007AFF; color: #ffffff; }
QMenu::item:disabled { color: #6E6E6E; background: transparent; }
QMenu::separator { height: 1px; background-color: #3A3A3A; margin: 5px 8px; }
QMenu::indicator { width: 14px; height: 14px; }

/* tabs */
QTabWidget::pane { border: 1px solid #3A3A3A; border-radius: 10px; background-color: #1E1E1E; top: -1px; }
QTabBar { background: transparent; qproperty-drawBase: 0; }
QTabBar::tab { background-color: transparent; color: #8C8C8C; border: none; border-radius: 12px; padding: 3px 14px; margin: 3px 2px; min-height: 18px; }
QTabBar::tab:selected { background-color: #383838; color: #DCDCDC; border: none; font-weight: 600; }
QTabBar::tab:hover:!selected { background-color: #2C2C2C; color: #DCDCDC; }

/* item views */
QListView, QTreeView, QTableView, QListWidget, QTreeWidget, QTableWidget { background-color: #1E1E1E; alternate-background-color: #252525; border: 1px solid #3A3A3A; border-radius: 8px; outline: none; }
QListWidget#sidebar, QListView#sidebar { background-color: #262626; border: none; border-radius: 0; padding: 6px; }
QListView::item { padding: 3px 6px; border-radius: 6px; }
QTreeView::item, QTableView::item { padding: 3px 6px; border-radius: 0; }
QListWidget#sidebar::item { min-height: 22px; border-radius: 10px; margin: 1px 2px; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background-color: #007AFF; color: #ffffff; }
QListWidget#sidebar::item:selected { background-color: #3E3E3E; color: #DCDCDC; }
QListView::item:hover:!selected, QTreeView::item:hover:!selected { background-color: #2C2C2C; }
QTreeView, QTableView { show-decoration-selected: 1; }
QHeaderView::section { background-color: transparent; color: #DCDCDC; border: none; border-bottom: 1px solid #3A3A3A; padding: 4px 8px; font-weight: 500; }
QTableCornerButton::section { background: transparent; border: none; }

/* scrollbars: thin */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:vertical { background-color: #6A6A6A; border-radius: 3px; min-height: 28px; margin: 2px; }
QScrollBar::handle:horizontal { background-color: #6A6A6A; border-radius: 3px; min-width: 28px; margin: 2px; }
QScrollBar::handle:hover { background-color: #8A8A8A; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { background: none; border: none; width: 0; height: 0; }

/* misc */
QGroupBox { background-color: #2C2C2C; border: none; border-radius: 12px; margin-top: 24px; padding: 10px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 4px; color: #DCDCDC; font-weight: 600; background: transparent; }
QStatusBar { background-color: #1E1E1E; color: #8C8C8C; }
QSplitter::handle { background-color: #3A3A3A; width: 1px; height: 1px; }
/* macOS dialogs have text-only buttons: hide the standard (emoji-like) button icons */
QDialogButtonBox QPushButton { min-width: 70px; icon-size: 0px; qproperty-iconSize: 0px 0px; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #3A3A3A; }
QDockWidget { border: 1px solid #3A3A3A; }
QCalendarWidget QToolButton { border-radius: 10px; }
